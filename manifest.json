{
  "manifest_version": 3,
  "name": "视频字幕文字稿",
  "version": "0.8.0",
  "description": "导出 YouTube、哔哩哔哩字幕，并通过本地 Whisper 提取小红书视频口播稿。",
  "minimum_chrome_version": "116",
  "permissions": ["offscreen", "tabCapture", "nativeMessaging"],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*",
    "https://*.xethub.hf.co/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "http://127.0.0.1:43127/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "高准确率本地转写"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["video-site.js", "transcript.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["bilibili-transcript.js", "bilibili-content.js"],
      "css": ["bilibili-content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["video-site.js", "transcript.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
